# 매뉴얼 원본 PDF — 저작권상 레포 제외 (출처·버전·해시는 manifest.json으로 추적, D19)
data/raw/*
!data/raw/manifest.json

# 목업 DB
*.db
*.sqlite3
# WAL 사이드카 (MQ-313) — 커넥션이 열려 있는 동안만 존재하는 런타임 파일
*.db-wal
*.db-shm

# 환경·시크릿
.env
.venv/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Node (frontend)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
*.db.bak
