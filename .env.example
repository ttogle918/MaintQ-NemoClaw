# MaintQ 환경변수 — 이 파일을 .env 로 복사해 채운다 (.env 는 git 제외)

# ── LLM (에이전트 루프)
# 읽는 순서 (D56): **OS 환경변수가 우선**, 이 파일은 빈 곳만 채운다 (override 안 함).
# 키가 이미 OS 환경변수에 있으면 여기는 비워 둬도 된다.
# 제공자 키·모델이 없으면 get_client() 는 **실패한다** —
# 테스트용 스크립트 응답으로 조용히 대체하지 않는다 (D40).

# 제공자: nvidia(현 기본) | openai | gemini | anthropic | elice
# 2026-08-29 D122 개정 — 기본 경로를 NVIDIA NIM 무료 티어로 두고 유료 OpenAI 를
# 폴백으로 뒤에 세운다(아래 MAINTQ_LLM_FALLBACK_* 참고). 평시 비용 0원.
MAINTQ_LLM_PROVIDER=nvidia
# provider=gemini 일 때 — GOOGLE_API_KEY 이름도 인정한다 (GEMINI_API_KEY 우선)
GEMINI_API_KEY=
# provider=anthropic 일 때만
ANTHROPIC_API_KEY=
# provider=elice 일 때만 (D115) — InsuQ ai-engine 의 elice provider를 이식.
# gemini 계열 모델을 Elice ML API(mlapi.run) 게이트웨이로 재판매받아 호출한다
# ("모델 교체가 아니라 경로 교체"). ELICE_LLM_URL 은 계정별 배포 URL이라
# 코드에 안 박는다 — 콘솔에서 발급받은 완전 URL 또는 bare api-id를 넣는다.
ELICE_API_KEY=
ELICE_LLM_URL=
# 사용할 모델 ID. 해커톤 제출 기준 기본값은 nvidia/nemotron-3-super-120b-a12b 다.
# (이전 실측 채택 모델 openai/gpt-oss-120b 는 2026-08-29 에 83개 카탈로그 중 9개를
# tool-calling·한국어 비율·응답시간으로 프로브해 고른 값이다 — 평가 수치는 그 모델 기준.)
# ⚠ 카탈로그(`/v1/models`)에 있다고 호출되는 것은 아니다 — 5개 중 3개가 404 였다.
MAINTQ_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── 자동 폴백 (2026-08-29) — 기본 경로가 죽었을 때 넘어갈 유료 경로.
# 크레딧 소진·인증 실패·모델 404 어느 쪽이든 첫 델타가 나가기 전이면 전환한다.
# ⚠ **둘 다** 채워야 켜진다. 하나만 있으면 켜지 않고 경고만 남긴다 —
#   절반만 적용하면 "폴백이 켜진 줄 알았는데 아니었다"가 된다.
# 비워 두면 폴백 없이 동작한다(이 변경 이전과 동일).
MAINTQ_LLM_FALLBACK_PROVIDER=openai
MAINTQ_LLM_FALLBACK_MODEL=gpt-4.1-mini

# ── DB (Sprint 16, D116 — SQLite→Postgres 전환)
# backend/db.py·mcp_server/db.py 는 Postgres 전용이다. 로컬 개발은 먼저
# `docker compose up -d postgres` 로 컨테이너(pgvector/pgvector:pg15, 포트 5434)를
# 띄운 뒤 아래를 채운다. 비워 두면 backend/db.py 기본값(postgresql://localhost/maintq)
# 으로 폴백하는데, 그 주소에 실제로 떠 있는 서버가 없으면 즉시 연결 실패한다 —
# SQLite 로 조용히 폴백하지 않는다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/maintq

# 계약 테스트(스파이크)가 실 DB 를 오염시키지 않도록 임시 사본으로 갈아끼우는 용도
# (SQLite 시절 메커니즘 — Postgres 스파이크는 대신 data/pg_isolation.py 의 격리
# 스키마를 쓴다). 평소에는 비워 둔다.
MAINTQ_DB=

# ── RAG 인덱스
# 기본: data/extracted/manual_chunks.jsonl (data/chunk_manual.py 산출물)
MAINTQ_CHUNKS=

# ── RAG dense(임베딩) 검색 — D117, Sprint 16 곁가지
# 비어 있으면 키워드 검색만 동작(D47 이 정의한 정상 상태 — 에러 아님).
# NVIDIA API 키. build.nvidia.com 개발자 프로그램에서 발급(현재 무료 티어로 확인됨).
# ⚠ 2026-08-29 부터 **생성(provider=nvidia)에도 쓰인다** — 아래 임베딩 전용이 아니다.
NVIDIA_API_KEY=
# 실제 호출로 확인된 모델 ID(2026-08-24). 카탈로그(`/v1/models`)에 Qwen 임베딩은 없었고,
# 실측(한국어 관련/무관 문장 판별) 결과 이 모델이 대안 중 가장 변별력이 좋았다 — 2,048차원.
# 모델을 바꾸면 scripts/postgres_schema.sql 의 manual_chunks.embedding 차원도 다시 맞출 것.
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# 기본값 있음(대부분 안 바꿔도 됨) — OpenAI 호환 엔드포인트가 다른 경우에만 지정.
NVIDIA_EMBED_BASE_URL=

# ── CORS
# 기본값은 localhost/127.0.0.1 의 3000~3005. 프론트 포트를 그 밖으로 옮길 때만 지정한다.
MAINTQ_CORS_ORIGINS=

# ── MCP
# 백엔드 기동 시 MCP 서버를 자동으로 띄울지 (기본 켜짐).
# 끄면 도구 호출이 전부 mcp_unavailable 로 실패한다 — /health 의 mcp 필드로 확인 가능.
MAINTQ_MCP_AUTOSTART=1

# ── MCP → 백엔드 REST (A2A 도구 2종 전용, Sprint 16)
# search_insurance_clause·assess_equipment_loan 이 mcp_server 프로세스에서 backend REST
# (/api/a2a/lookup-clause·/api/a2a/assess-loan)를 HTTP 로 호출할 때 쓰는 주소.
# backend.a2a 를 직접 import 하지 않는다(D15·D93) — 이게 그 대신 쓰는 네트워크 경로다.
# 기본: http://localhost:8000
MAINTQ_BACKEND_BASE_URL=

# ══ A2A 파트너 자격증명 (D120) ══
# ⚠ LLM 키와 성격이 다르다: 이 자격증명으로 나가는 요청은 돈을 움직인다(S5).
#    값 자체는 상대 시스템(InsuQ·FinAllQ)이 자기 .env 에 이미 가진 것과 같아야 한다 —
#    InsuQ 는 이 값을 A2A_MOCK_TOKEN(자기 자신의 인바운드 공유 시크릿)과 그대로 비교한다.
# 읽는 곳: backend/a2a/credentials.py 한 곳. **MCP 도구는 접근하지 않는다** (D15·D93).
# 비어 있어도 앱 기동·회귀·평가에 영향이 없다 → status='not_configured'.
# ⛔ 실제 값을 이 파일·세션 로그·주석 어디에도 적지 말 것.
# 호출 시 MaintQ 는 Authorization: Bearer <값> + X-A2A-Partner-Id: maintq-agent 로
# 자신을 신고한다(credentials.SELF_PARTNER_ID — InsuQ CustomerSeeder.java 시드값과
# 일치해야 한다, 값이 다르면 401/403).
FINALLQ_SERVICE_TOKEN=
# A2A 파트너 어댑터 주소. 비워 두면 코드 기본값을 쓴다 —
#   InsuQ  http://localhost:8081  (2026-08-30 Spring backend 로 이관. 옛 FastAPI
#                                  어댑터 :9102 는 삭제돼 더는 존재하지 않는다)
#   FinAllQ http://localhost:9101
# 배포 환경에서는 반드시 실제 주소로 채운다 — 기본값은 로컬 개발 전제다.
MAINTQ_A2A_INSUQ_BASE_URL=
MAINTQ_A2A_FINALLQ_BASE_URL=

INSUQ_SERVICE_TOKEN=

# ══════════════════════════════════════════════════════════════════
# 외부 데이터 원천 (확장 범위 · D67)
# ══════════════════════════════════════════════════════════════════
# 이 절의 키는 **수집 스크립트 전용**이다. 수집은 개발 시점 작업이고
# 런타임 서버는 커밋된 스냅샷만 읽는다 (11_ASSET_LIFECYCLE §7).
# backend/·mcp_server/ 는 아래 키를 절대 참조하지 않는다 — 요청마다 외부 기관을
# 호출하면 "서명 시점 스냅샷 재현" 전제가 깨진다.
# 키가 없으면 수집 스크립트만 실패하고 앱 기동에는 영향이 없다.

# ── 법제처 국가법령정보 (계층 1 · 법령 원문)
# 신청: https://open.law.go.kr → OPEN API → 활용신청 (승인 즉시)
# ⚠ 인증값은 **API 키가 아니라 신청한 이메일 ID 앞부분**이다.
#    예) hong@gmail.com 으로 신청했으면 → hong
# 확인: https://www.law.go.kr/DRF/lawSearch.do?OC=<값>&target=law&type=JSON&query=조세특례제한법
# ⚠ 실패해도 **HTTP 200** 이고 JSON 파싱도 성공한다 — 조용히 넘어가기 쉽다.
#    수집 스크립트는 아래 두 문자열을 반드시 실패로 취급할 것:
#      값이 빔      → {"result":"필수입력요소 검증에 실패하였습니다"}
#      값이 틀림    → {"result":"사용자 정보 검증에 실패하였습니다.",
#                      "msg":"... 서버장비의 IP주소 및 도메인주소를 등록해 주세요"}
# ⚠⚠ 두 번째 메시지는 **오해를 유발한다.** IP 를 등록하라고 안내하지만
#     실제로는 **OC 값이 틀렸을 때도 똑같이 나온다** (2026-08-09 실측: 값이 5자로 잘려 있을 때
#     이 메시지, 전체 값으로 고치니 정상 200). IP 부터 의심하지 말고 **OC 값 길이를 먼저 확인**할 것.
#     ⛔ 실제 OC 값을 이 파일·세션 로그·주석 어디에도 적지 말 것 — 재현에 값 자체는 필요 없다.
# data/rules/fetch_laws.py 는 이 이름을 읽는다. 개명 전 이름은 폴백으로만 인정하므로
# 예전 이름으로 넣어둔 값이 있다면 이쪽으로 옮길 것.
LAW_API_OC=

# ── 공공데이터포털 (data.go.kr)
# 계정당 인증키 1개로 **승인된 모든 API 공용**이다. API 마다 따로 받지 않는다.
# 확인: data.go.kr > 마이페이지 > 인증키 발급현황
# 사용처: 중진공 자산거래중개장터 · 캠코 온비드 동산 · 국세청 사업자등록 상태조회 · 조달청 낙찰정보
# 대부분 Decoding 키를 쓴다 (requests 등이 자체 인코딩하므로).
DATA_GO_KR_SERVICE_KEY=

# ── 법원 등기정보광장 (동산·채권담보등기 통계)
# 신청: https://data.iros.go.kr → Open API (법제처와 **별개 사이트**, 별도 회원가입)
# ⚠ 공공데이터포털과 달리 **서비스마다 인증키가 따로 발급된다** (공용 키 없음).
#    신청 2026-08-07 / 만료 **2028-08-07** — 만료 전 재발급 필요.
# ⚠ 제공되는 건 **집계 통계뿐**이다 — 개별 물건의 담보 설정 여부는 조회할 수 없다.
#    (등기부 열람은 iros.go.kr 유료 + 본인확인). 이 한계 자체가 S18 의 PARTIAL 근거다.
# ⚠ "동산·채권" 합산 통계다. 동산 중 기계설비 비중은 공개되지 않으므로
#    "기계설비 담보가 연 N건" 으로 인용하면 사실 왜곡이다 (11 §4 불변식 6).
# ⚠ 1일 1,000건 초과 시 3개월 이용 제한 + API 키 자동 차단 → 배치 1회 수집 후 캐시할 것.

# ⭐ 1순위 — 동산·채권담보등기 신청사건 현황
#    건수 · 동산/채권 구분 · 담보권설정자 구분 · 기간(일/월/년)
#    용도: "동산담보 설정이 연 N건 규모" 라는 발생 빈도 근거 (S18 residual_risk)
IROS_API_KEY_APPLY_CASES=

# ⭐ 2순위 — 동산·채권담보등기 신청현황(채권최고액별)
#    건수 · 채권최고액 구간 · 기간
#    용도: 금액 구간을 중진공 설비 가격대(중앙 630만·p90 8천만)와 대조
IROS_API_KEY_APPLY_BY_AMOUNT=

# 보조 — 동산·채권담보등기 현황(담보권설정자 유형별) · 매월 말일 기준 등기기록수(스톡)
IROS_API_KEY_STATUS_BY_GRANTOR=

# 보조 — 동산·채권담보등기 누적채권액 현황(담보권설정자 유형별) · 금액 총합
IROS_API_KEY_DEBT_BY_GRANTOR=


# 문서 파싱(PDF→JSON) — Elice ML API (eliceai/helpy-document-vision)
ELICE_API_KEY=
ELICE_DOCVISION_URL=       # 모델 라이브러리 페이지의 추론 엔드포인트 (계정별이라 코드에 안 박음)

OPENAI_API_KEY=

A2A_MOCK_TOKEN=
MAINT_SERVICE_TOKEN=
INSUQ_SERVICE_TOKEN=
FINALLQ_SERVICE_TOKEN=
