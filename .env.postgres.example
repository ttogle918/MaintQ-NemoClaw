# MaintQ Postgres 환경변수 예시

# ── Postgres 연결
# Postgres 데이터베이스 연결 문자열 (Supabase, Neon, Docker 등)
# 이 파일을 참고해 .env에 실제 값을 설정한다 (DATABASE_URL은 git 제외)

# 로컬 개발 (Docker Compose):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintq

# Supabase (클라우드):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT_ID].supabase.co:5432/postgres

# Neon (클라우드):
# DATABASE_URL=postgresql://[user]:[password]@[host]/maintq?sslmode=require

DATABASE_URL=

# ── 기존 SQLite 경로 (deprecated, 비움)
# Postgres로 마이그레이션 완료 후에는 이 항목을 사용하지 않는다
MAINTQ_DB=
